{
  // CloudFormation / SAM use YAML short-form intrinsic functions (!Sub, !Ref,
  // !GetAtt, !If ...). The generic YAML language server does not know them and
  // reports "Unresolved tag: !Sub" unless they are declared here.
  "yaml.customTags": [
    "!And",
    "!And sequence",
    "!Base64",
    "!Base64 mapping",
    "!Cidr",
    "!Cidr sequence",
    "!Condition",
    "!Equals",
    "!Equals sequence",
    "!FindInMap",
    "!FindInMap sequence",
    "!GetAZs",
    "!GetAtt",
    "!GetAtt sequence",
    "!If",
    "!If sequence",
    "!ImportValue",
    "!ImportValue mapping",
    "!Join",
    "!Join sequence",
    "!Not",
    "!Not sequence",
    "!Or",
    "!Or sequence",
    "!Ref",
    "!Select",
    "!Select sequence",
    "!Split",
    "!Split sequence",
    "!Sub",
    "!Sub mapping",
    "!Sub sequence",
    "!Transform",
    "!Transform mapping"
  ],

  // No JSON schema is attached to the CloudFormation templates on purpose.
  // The YAML extension has no CloudFormation/SAM schema, and forcing an
  // unrelated one makes it reject valid template keys. cfn-lint (run in CI and
  // available via the cfn-lint extension) is what actually validates them.
  "yaml.schemas": {},

  "[yaml]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  }
}
